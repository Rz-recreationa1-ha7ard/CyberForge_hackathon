{
  "project_name": "CyberForge Autonomous PTES Engine",
  "tier": "recon",
  "scope": {
    "allowed_cidrs": [
      "192.168.60.0/24"
    ],
    "allowed_ports": null,
    "max_scan_timeout_seconds": 1200
  },
  "reporting": {
    "api_host": "0.0.0.0",
    "api_port": 8000,
    "export_dir": "./reports",
    "auto_generate_on_finish": true
  },
  "agents": [
    {
      "name": "network_discovery",
      "role": "Network and Port Enumerator",
      "surface": "network",
      "enabled": true,
      "triggers": ["startup"],
      "parameters": {
        "socket_timeout": 0.4,
        "max_threads": 50
      }
    },
    {
      "name": "web_agent",
      "role": "Web Application Surface Analyzer",
      "surface": "web",
      "enabled": true,
      "triggers": ["service:http", "service:https"],
      "parameters": {
        "max_crawl_depth": 2,
        "request_timeout_seconds": 3,
        "user_agent": "CyberForge-Auditor/1.0"
      }
    },
    {
      "name": "verification_agent",
      "role": "Finding Verification & False-Alarm Eliminator",
      "surface": "web",
      "enabled": true,
      "triggers": ["finding:unverified"],
      "parameters": {
        "timeout_seconds": 3
      }
    }
  ]
}
